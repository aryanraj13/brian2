# Google Cloud OAuth client (Gmail + Drive) — free, from console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Filled in automatically by `npm run auth` — do not set manually
GOOGLE_REFRESH_TOKEN=

# Gemini free-tier API key — from aistudio.google.com/apikey
GEMINI_API_KEY=
